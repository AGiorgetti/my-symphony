{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "O"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Orchestration": {
    "InitialState": "Stopped"
  },
  "Dashboard": {
    "DebugMode": false,
    "TrackAgentMessageDeltas": false
  }
}
