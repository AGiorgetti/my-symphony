@if (Sessions.Count == 0)
{
    <MudPaper Class="@EmptyStateClass" Outlined="true" Elevation="0" data-testid="session-list-empty-state">
        <p class="empty-state__title">No sessions in this view</p>
        <p class="empty-state__copy">
            Change the filter or wait for more agent activity to populate the session explorer.
        </p>
    </MudPaper>
}
else
{
    <MudPaper Class="session-table-card"
              Outlined="true"
              Elevation="0"
         data-testid="session-list-table">
        <div class="session-table-wrap">
            <MudTable Items="@Sessions"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh>Issue</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Started</MudTh>
                    <MudTh>Ended / Duration</MudTh>
                    <MudTh>Outcome / last event</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Issue">
                                <div class="session-table-link-group">
                                    <a class="session-table-link"
                                       href="/sessions/@Uri.EscapeDataString(context.IssueIdentifier)">
                                        @context.IssueIdentifier
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(context.IssueUrl))
                                    {
                                        <a class="session-table-subtle-link"
                                           href="@context.IssueUrl">
                                            Tracker issue
                                        </a>
                                    }
                                </div>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <StatusPill Text="@context.Status" Color="@SessionListDisplay.GetStatusColor(context)" />
                    </MudTd>
                    <MudTd DataLabel="Started" Class="session-table-cell session-table-cell--nowrap">
                        @SessionListDisplay.FormatTimestamp(context.StartedAt)
                    </MudTd>
                    <MudTd DataLabel="Ended / Duration" Class="session-table-cell">
                                <div class="session-table-primary">
                            @(context.EndedAt is null ? "Live" : SessionListDisplay.FormatTimestamp(context.EndedAt.Value))
                                </div>
                        <div>@SessionListDisplay.GetDurationLabel(context)</div>
                    </MudTd>
                    <MudTd DataLabel="Outcome / last event" Class="session-table-cell">
                        <div class="session-table-primary">@context.Summary</div>
                        @if (!string.IsNullOrWhiteSpace(context.Detail))
                                {
                            <div class="session-table-detail">@context.Detail</div>
                                }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </MudPaper>
}

@code {
    private const string EmptyStateClass = "empty-state";

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<SessionListRowViewModel> Sessions { get; set; }
}
