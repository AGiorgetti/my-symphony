@using Symphony.Domain.Runs

<StatusPill Text="@ResolveText()" Color="@ResolveColor()" />

@code {
    [Parameter]
    public RunAttemptStatus? Status { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public Color? ColorOverride { get; set; }

    private Color ResolveColor()
    {
        if (ColorOverride is not null)
        {
            return ColorOverride.Value;
        }

        return Status is null
            ? Color.Primary
            : GetColor(Status.Value);
    }

    private string ResolveText()
    {
        if (!string.IsNullOrWhiteSpace(Text))
        {
            return Text;
        }

        return Status?.ToString() ?? string.Empty;
    }

    private static Color GetColor(RunAttemptStatus status)
    {
        return status switch
        {
            RunAttemptStatus.Succeeded => Color.Success,
            RunAttemptStatus.PreparingWorkspace => Color.Info,
            RunAttemptStatus.BuildingPrompt => Color.Info,
            RunAttemptStatus.LaunchingAgentProcess => Color.Info,
            RunAttemptStatus.InitializingSession => Color.Info,
            RunAttemptStatus.StreamingTurn => Color.Info,
            RunAttemptStatus.Finishing => Color.Info,
            RunAttemptStatus.BlockedError => Color.Warning,
            RunAttemptStatus.Failed => Color.Error,
            RunAttemptStatus.TimedOut => Color.Error,
            RunAttemptStatus.Stalled => Color.Error,
            RunAttemptStatus.CanceledByReconciliation => Color.Default,
            _ => Color.Primary
        };
    }
}
