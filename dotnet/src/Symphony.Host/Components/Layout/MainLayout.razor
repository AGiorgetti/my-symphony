@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Globalization
@using Symphony.Abstractions.Orchestration
@using Flowbite.Layout
@inject IDashboardStateService DashboardStateService
@inject IOrchestratorControl OrchestratorControl
@inject IThemeService ThemeService

<div class="min-h-screen bg-transparent text-[var(--color-on-surface-primary)] lg:flex">
    <div class="hidden lg:block lg:w-64 lg:shrink-0">
        <Sidebar>
            @SidebarContent
        </Sidebar>
    </div>

    @if (!_isSidebarCollapsed)
    {
        <button class="fixed inset-0 z-30 bg-slate-950/45 lg:hidden"
                aria-label="Close menu"
                @onclick="CloseSidebar">
        </button>

        <div class="fixed inset-y-0 left-0 z-40 w-64 lg:hidden">
            <Sidebar>
                @SidebarContent
            </Sidebar>
        </div>
    }

    <div class="min-h-screen min-w-0 flex-1">
        <nav class="sticky top-0 z-30 border-b border-[var(--shell-border)] bg-[color:var(--color-surface-overlay)]/95 backdrop-blur">
            <div class="flex w-full items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
                <div class="flex items-center gap-3">
                    <div class="lg:hidden">
                        <Button OnClick="ToggleSidebarAsync">Menu</Button>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.24em] text-[color:var(--color-primary-DEFAULT)]">Symphony</p>
                        <h1 class="text-lg font-semibold text-[color:var(--color-on-surface-primary)]">Operator Dashboard</h1>
                    </div>
                </div>

                <div class="hidden items-center gap-2 text-sm text-[color:var(--color-on-surface-secondary)] sm:flex">
                    <span>Live sessions</span>
                    <span class="inline-flex min-w-8 items-center justify-center rounded-full bg-[color:var(--color-primary-DEFAULT)] px-2 py-1 font-semibold text-slate-950">
                        @_runningSessionsLabel
                    </span>
                </div>
            </div>
        </nav>

        <main class="flex min-h-[calc(100vh-4.5rem)] w-full flex-col px-4 py-4 sm:px-6 lg:px-8">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <section class="rounded-[var(--shell-radius-xl)] border border-[var(--shell-border)] bg-[color:var(--color-surface-raised)] p-8 shadow-[var(--shell-shadow)]">
                        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[color:var(--color-primary-DEFAULT)]">Symphony</p>
                        <h2 class="mt-3 text-3xl font-semibold text-[color:var(--color-on-surface-primary)]">Layout content failed to render</h2>
                        <p class="mt-3 max-w-2xl text-base leading-7 text-[color:var(--color-on-surface-secondary)]">
                            The page UI hit an error, but the orchestrator and API remain available.
                        </p>
                    </section>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>

    <ToastHost Position="ToastPosition.BottomRight" />
</div>

@code {
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellationTokenSource;
    private Task? _refreshLoopTask;
    private bool _isSidebarCollapsed = true;
    private string _runningSessionsLabel = "0";
    private OrchestratorControlState _orchestratorState = OrchestratorControlState.Started;
    private string _orchestratorStateLabel = "Started";
    private bool _isUpdatingOrchestratorState;

    protected override async Task OnInitializedAsync()
    {
        await RefreshRunningCountAsync();

        _refreshCancellationTokenSource = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _refreshLoopTask = RunRefreshLoopAsync(_refreshCancellationTokenSource.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeService.InitializeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCancellationTokenSource is not null)
        {
            await _refreshCancellationTokenSource.CancelAsync();
            _refreshCancellationTokenSource.Dispose();
            _refreshCancellationTokenSource = null;
        }

        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (_refreshLoopTask is not null)
        {
            try
            {
                await _refreshLoopTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private Task ToggleSidebarAsync()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
        return Task.CompletedTask;
    }

    private void CloseSidebar()
    {
        _isSidebarCollapsed = true;
    }

    private RenderFragment SidebarContent => @<text>
        <SidebarLogo Href="/">Symphony</SidebarLogo>
        <SidebarItemGroup>
            <SidebarItem Href="/" Icon="@(new HomeIcon())">
                Dashboard
            </SidebarItem>
            <SidebarItem Href="/sessions"
                         Label="@_runningSessionsLabel"
                         LabelColorValue="SidebarItem.LabelColor.Primary">
                Sessions
            </SidebarItem>
        </SidebarItemGroup>

        <div class="mt-auto space-y-4 border-t border-[var(--shell-border)] px-3 pb-4 pt-4">
            <section class="space-y-3" data-testid="orchestrator-control-panel">
                <div class="rounded-[var(--shell-radius-lg)] border border-[var(--shell-border)] bg-[color:var(--color-surface-overlay)]/80 p-3">
                    <p class="text-xs font-bold uppercase tracking-[0.24em] text-[color:var(--color-primary-DEFAULT)]">Orchestrator</p>
                    <div class="mt-3 space-y-2">
                        <span class="@GetOrchestratorStateBadgeClasses()" data-testid="orchestrator-control-state">
                            @_orchestratorStateLabel
                        </span>
                        <p class="text-sm leading-6 text-[color:var(--color-on-surface-secondary)]">
                            @GetOrchestratorDescription()
                        </p>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <button class="@GetOrchestratorActionButtonClasses(_orchestratorState == OrchestratorControlState.Started)"
                            data-testid="orchestrator-start-button"
                            disabled="@(_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Started)"
                            @onclick="StartOrchestratorAsync">
                        Start
                    </button>
                    <button class="@GetOrchestratorActionButtonClasses(_orchestratorState == OrchestratorControlState.Stopped)"
                            data-testid="orchestrator-stop-button"
                            disabled="@(_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Stopped)"
                            @onclick="StopOrchestratorAsync">
                        Stop
                    </button>
                </div>
            </section>

            <ThemeSwitcher ThemeService="ThemeService" />
        </div>
    </text>;

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshRunningCountAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshRunningCountAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var snapshot = await DashboardStateService.GetSnapshotAsync(cancellationToken);
            _runningSessionsLabel = snapshot.RunningCount.ToString(CultureInfo.InvariantCulture);
            _orchestratorState = snapshot.OrchestratorState;
            _orchestratorStateLabel = snapshot.OrchestratorState == OrchestratorControlState.Started
                ? "Started"
                : "Stopped";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            // Keep the shell responsive even if dashboard state refresh fails.
        }
    }

    private async Task StartOrchestratorAsync()
    {
        if (_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Started)
        {
            return;
        }

        _isUpdatingOrchestratorState = true;

        try
        {
            await OrchestratorControl.ResumeAsync();
            await RefreshRunningCountAsync();
        }
        finally
        {
            _isUpdatingOrchestratorState = false;
        }
    }

    private async Task StopOrchestratorAsync()
    {
        if (_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Stopped)
        {
            return;
        }

        _isUpdatingOrchestratorState = true;

        try
        {
            await OrchestratorControl.PauseAsync();
            await RefreshRunningCountAsync();
        }
        finally
        {
            _isUpdatingOrchestratorState = false;
        }
    }

    private string GetOrchestratorStateBadgeClasses()
    {
        return _orchestratorState == OrchestratorControlState.Started
            ? "inline-flex items-center rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-300"
            : "inline-flex items-center rounded-full bg-amber-400/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-amber-200";
    }

    private string GetOrchestratorActionButtonClasses(bool isActiveAction)
    {
        var baseClasses = "inline-flex w-full items-center justify-center rounded-xl border px-3 py-2 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-50";

        return isActiveAction
            ? $"{baseClasses} border-[color:var(--color-primary-DEFAULT)] bg-[color:var(--color-primary-DEFAULT)] text-slate-950"
            : $"{baseClasses} border-[var(--shell-border)] bg-[color:var(--color-surface-overlay)] text-[color:var(--color-on-surface-primary)] hover:border-[color:var(--color-primary-DEFAULT)]";
    }

    private string GetOrchestratorDescription()
    {
        return _orchestratorState == OrchestratorControlState.Started
            ? "New issue assignment is enabled."
            : "New issue assignment is paused until the orchestrator is started.";
    }
}
