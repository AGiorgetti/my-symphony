@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using Symphony.Abstractions.Orchestration
@inject IDashboardPageDataService DashboardPageDataService
@inject IOrchestratorControl OrchestratorControl
@inject IThemeService ThemeService
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="@CurrentMudTheme" IsDarkMode="@CurrentThemeIsDark" />
<MudSnackbarProvider />

<div class="app-shell">
    <MudPaper Class="app-shell__sidebar app-shell__sidebar--desktop"
              Square="true"
              Elevation="0">
        @SidebarContent
    </MudPaper>

    @if (_isSidebarOpen)
    {
        <button class="app-shell__scrim"
                aria-label="Close menu"
                @onclick="CloseSidebar">
        </button>

        <MudPaper Class="app-shell__sidebar app-shell__sidebar--mobile"
                  Square="true"
                  Elevation="0">
                @SidebarContent
        </MudPaper>
    }

    <div class="app-shell__content">
        <nav class="app-topbar">
            <div class="app-topbar__inner">
                <div class="app-topbar__leading">
                    <div class="app-topbar__menu">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   Class="app-topbar__menu-button"
                                   OnClick="ToggleSidebarAsync">
                            Menu
                        </MudButton>
                    </div>
                    <div class="app-topbar__brand">
                        <p class="section-kicker">Symphony</p>
                        <h1 class="app-topbar__title">Operator Dashboard</h1>
                    </div>
                </div>

                <div class="app-topbar__meta">
                    <span>Live sessions</span>
                    <span class="app-topbar__count">
                        @_runningSessionsLabel
                    </span>
                </div>
            </div>
        </nav>

        <main class="app-shell__main">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <section class="page-card app-layout-error">
                        <p class="section-kicker">Symphony</p>
                        <h2 class="page-title page-title--secondary">Layout content failed to render</h2>
                        <p class="page-copy app-layout-error__copy">
                            The page UI hit an error, but the orchestrator and API remain available.
                        </p>
                    </section>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellationTokenSource;
    private Task? _refreshLoopTask;
    private bool _isSidebarOpen;
    private DashboardPageMode _mode = new(DashboardDataMode.Live);
    private string _runningSessionsLabel = "0";
    private OrchestratorControlState _orchestratorState = OrchestratorControlState.Started;
    private string _orchestratorStateLabel = "Started";
    private bool _isUpdatingOrchestratorState;
    private MudTheme CurrentMudTheme => MudThemeCatalog.GetTheme(ThemeService.CurrentTheme);
    private bool CurrentThemeIsDark => ThemeService.AvailableThemes.FirstOrDefault(theme =>
        string.Equals(theme.Key, ThemeService.CurrentTheme, StringComparison.OrdinalIgnoreCase))?.IsDark ?? true;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
        _mode = ResolveCurrentMode();
        await RefreshRunningCountAsync();

        _refreshCancellationTokenSource = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _refreshLoopTask = RunRefreshLoopAsync(_refreshCancellationTokenSource.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeService.InitializeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;

        if (_refreshCancellationTokenSource is not null)
        {
            await _refreshCancellationTokenSource.CancelAsync();
            _refreshCancellationTokenSource.Dispose();
            _refreshCancellationTokenSource = null;
        }

        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (_refreshLoopTask is not null)
        {
            try
            {
                await _refreshLoopTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private Task ToggleSidebarAsync()
    {
        _isSidebarOpen = !_isSidebarOpen;
        return Task.CompletedTask;
    }

    private void CloseSidebar()
    {
        _isSidebarOpen = false;
    }

    private RenderFragment SidebarContent => @<text>
        <div class="sidebar-header">
            <NavLink href="@DashboardPageDataService.BuildLink("/", _mode)"
                     Match="NavLinkMatch.All"
                     class="sidebar-title-link">
                Symphony
            </NavLink>
            <p class="sidebar-subtitle">
                Operator shell
            </p>
        </div>

        <nav class="sidebar-nav">
            <NavLink href="@DashboardPageDataService.BuildLink("/", _mode)"
                     Match="NavLinkMatch.All"
                     class="sidebar-nav-link">
                Dashboard
            </NavLink>
            <NavLink href="@DashboardPageDataService.BuildLink("/sessions", _mode)"
                     class="sidebar-nav-link">
                <span class="sidebar-nav-link__content">
                    <span>Sessions</span>
                    <StatusPill Text="@_runningSessionsLabel" Color="Color.Primary" />
                </span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <section class="sidebar-section" data-testid="orchestrator-control-panel">
                <MudPaper Class="sidebar-panel"
                          Outlined="true"
                          Elevation="0">
                    <p class="section-kicker">Orchestrator</p>
                    <div class="sidebar-panel__content">
                        <span class="@GetOrchestratorStateBadgeClasses()"
                              data-testid="orchestrator-control-state">
                            @_orchestratorStateLabel
                        </span>
                        <p class="sidebar-panel__description">
                            @GetOrchestratorDescription()
                        </p>
                    </div>
                </MudPaper>

                <div class="sidebar-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Class="sidebar-action sidebar-action--start"
                               data-testid="orchestrator-start-button"
                               Disabled="@(_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Started)"
                               OnClick="StartOrchestratorAsync">
                        Start
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Class="sidebar-action sidebar-action--stop"
                               data-testid="orchestrator-stop-button"
                               Disabled="@(_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Stopped)"
                               OnClick="StopOrchestratorAsync">
                        Stop
                    </MudButton>
                </div>
            </section>

            <ThemeSwitcher ThemeService="ThemeService" />
        </div>
    </text>;

    private void HandleThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _mode = ResolveCurrentMode();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshRunningCountAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshRunningCountAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var snapshot = await DashboardPageDataService.GetDashboardSnapshotAsync(_mode, cancellationToken);
            _runningSessionsLabel = snapshot.RunningCount.ToString(CultureInfo.InvariantCulture);
            _orchestratorState = snapshot.OrchestratorState;
            _orchestratorStateLabel = snapshot.OrchestratorState == OrchestratorControlState.Started
                ? "Started"
                : "Stopped";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            // Keep the shell responsive even if dashboard state refresh fails.
        }
    }

    private DashboardPageMode ResolveCurrentMode()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("mode", out var values);
        return DashboardPageDataService.ResolveMode(values.FirstOrDefault());
    }

    private async Task StartOrchestratorAsync()
    {
        if (_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Started)
        {
            return;
        }

        _isUpdatingOrchestratorState = true;

        try
        {
            await OrchestratorControl.ResumeAsync();
            await RefreshRunningCountAsync();
        }
        finally
        {
            _isUpdatingOrchestratorState = false;
        }
    }

    private async Task StopOrchestratorAsync()
    {
        if (_isUpdatingOrchestratorState || _orchestratorState == OrchestratorControlState.Stopped)
        {
            return;
        }

        _isUpdatingOrchestratorState = true;

        try
        {
            await OrchestratorControl.PauseAsync();
            await RefreshRunningCountAsync();
        }
        finally
        {
            _isUpdatingOrchestratorState = false;
        }
    }

    private string GetOrchestratorStateBadgeClasses()
    {
        return _orchestratorState == OrchestratorControlState.Started
            ? "control-state-pill control-state-pill--started"
            : "control-state-pill control-state-pill--stopped";
    }

    private string GetOrchestratorDescription()
    {
        return _orchestratorState == OrchestratorControlState.Started
            ? "New issue assignment is enabled."
            : "New issue assignment is paused until the orchestrator is started.";
    }
}
