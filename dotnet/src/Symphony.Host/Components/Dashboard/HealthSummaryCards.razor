@using Symphony.Host.Dashboard

@if (Alerts.Count > 0)
{
    <div class="summary-alerts" data-testid="dashboard-summary-alerts">
        @foreach (var alert in Alerts)
        {
            <MudAlert Severity="@alert.Color"
                      Variant="Variant.Outlined"
                      Dense="true">
                <strong>@alert.TextEmphasis</strong> @alert.Text
            </MudAlert>
        }
    </div>
}

<div class="summary-grid" data-testid="dashboard-summary-grid">
    <MudPaper Class="@CardClass" Outlined="true" Elevation="0">
        <p class="section-kicker">Service Health</p>
        <div class="summary-card__status">
            <StatusPill Text="@Snapshot.ServiceHealth" Color="@DashboardDisplay.GetHealthBadgeColor(Snapshot.ServiceHealth)" />
            <span class="body-copy body-copy--muted">@Snapshot.RunningCount running</span>
        </div>
        <p class="section-copy">@DashboardDisplay.GetHealthMessage(Snapshot)</p>
    </MudPaper>

    <MudPaper Class="@CardClass" Outlined="true" Elevation="0">
        <p class="section-kicker">Orchestrator Mode</p>
        <h2 class="section-title section-title--card">@Snapshot.OrchestratorMode</h2>
        <p class="section-copy">
            State is tracked in-process and served live for the operator shell.
        </p>
        <p class="body-copy body-copy--muted">
            Retry queue: @Snapshot.RetryingCount queued · Needs attention: @Snapshot.BlockedCount
        </p>
    </MudPaper>

    <MudPaper Class="@CardClass" Outlined="true" Elevation="0">
        <p class="section-kicker">Last Poll Tick</p>
        <h2 class="section-title section-title--card">
            @DashboardDisplay.FormatTimestamp(Snapshot.LastPollTickAt)
        </h2>
        <p class="section-copy">@DashboardDisplay.GetPollMessage(Snapshot)</p>
        <p class="body-copy body-copy--muted">
            Runtime: @DashboardDisplay.FormatDuration(Snapshot.SecondsRunning)
        </p>
    </MudPaper>

    <MudPaper Class="@CardClass" Outlined="true" Elevation="0">
        <p class="section-kicker">Workflow Config</p>
        <div class="summary-card__status">
            <StatusPill Text="@Snapshot.WorkflowLoadStatus" Color="@DashboardDisplay.GetWorkflowBadgeColor(Snapshot.WorkflowLoadStatus)" />
            <span class="body-copy body-copy--muted">@Snapshot.TotalTokens tokens</span>
        </div>
        <p class="section-copy">@DashboardDisplay.GetWorkflowMessage(Snapshot)</p>
    </MudPaper>
</div>

@code {
    private const string CardClass = "summary-card";

    [Parameter]
    [EditorRequired]
    public required DashboardSnapshot Snapshot { get; set; }

    private IReadOnlyList<DashboardAlertMessage> Alerts => DashboardDisplay.GetAlerts(Snapshot);
}
