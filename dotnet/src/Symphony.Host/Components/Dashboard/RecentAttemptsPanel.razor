@using Symphony.Host.Dashboard

<MudPaper Class="@PanelClass" Outlined="true" Elevation="0" data-testid="dashboard-recent-attempts">
    <div class="panel-header">
        <div class="panel-header__content">
            <p class="section-kicker">Recent Attempts</p>
            <h2 class="section-title section-title--panel">Latest outcomes</h2>
            <p class="section-copy">
                Most recent run outcomes with concise error summaries for operator triage.
            </p>
        </div>
        <StatusPill Text="@Attempts.Count.ToString()" Color="Color.Primary" />
    </div>

    @if (Attempts.Count == 0)
    {
        <div class="empty-state">
            <p class="empty-state__title">No recent attempts yet</p>
            <p class="empty-state__copy">
                Completed worker attempts will appear here after the first run finishes.
            </p>
        </div>
    }
    else
    {
        <ul class="panel-list">
            @foreach (var attempt in Attempts)
            {
                <li class="panel-item">
                    <div class="panel-item__header">
                        <span class="panel-item__title">@attempt.IssueIdentifier</span>
                        <StatusPill Text="@attempt.Outcome" Color="@DashboardDisplay.GetOutcomeBadgeColor(attempt.Outcome)" />
                    </div>
                    <div class="panel-item__meta">
                        <p>@GetAttemptLabel(attempt.Attempt) · finished @DashboardDisplay.FormatTimestamp(attempt.CompletedAt) · @DashboardDisplay.FormatDuration(attempt.DurationSeconds)</p>
                        @if (!string.IsNullOrWhiteSpace(attempt.SessionId))
                        {
                            <p>Session @attempt.SessionId</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(attempt.Error))
                        {
                            <p>@attempt.Error</p>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</MudPaper>

@code {
    private const string PanelClass = "panel-card";

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<DashboardRecentAttemptSnapshot> Attempts { get; set; }

    private static string GetAttemptLabel(int? attempt)
    {
        return attempt is null ? "Initial run" : $"Attempt {attempt}";
    }
}
