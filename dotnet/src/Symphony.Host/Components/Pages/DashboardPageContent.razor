@implements IAsyncDisposable
@using Symphony.Host.Components.Dashboard
@inject IDashboardPageDataService DashboardPageDataService

<main class="page-shell page-stack">
    @if (_isLoading)
    {
        <section class="summary-grid" data-testid="dashboard-skeleton">
            @for (var index = 0; index < 4; index++)
            {
                <MudPaper Class="@SkeletonCardClass" Outlined="true" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="45%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="6rem" Height="2.25rem" />
                </MudPaper>
            }
        </section>

        <section class="operations-grid">
            @for (var index = 0; index < 4; index++)
            {
                <MudPaper Class="@SkeletonCardClass" Outlined="true" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="55%" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="12rem" />
                </MudPaper>
            }
        </section>
    }
    else if (_snapshot is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_refreshErrorMessage))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                <strong>Refresh warning:</strong> @_refreshErrorMessage
            </MudAlert>
        }

            <ErrorBoundary>
                <ChildContent>
                    <HealthSummaryCards Snapshot="_snapshot" />
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="@FallbackCardClass" Outlined="true" Elevation="0" data-testid="dashboard-summary-fallback">
                        <p class="section-kicker">Dashboard summary</p>
                        <h2 class="section-title section-title--card">Summary panel failed</h2>
                        <p class="section-copy">
                            The shell is still responsive, but the summary cards hit a rendering error.
                        </p>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>

        <section class="operations-grid" aria-label="Operational panels">
            <ErrorBoundary>
                <ChildContent>
                    <ActiveSessionsPanel Sessions="_snapshot.ActiveSessions"
                                         GeneratedAt="_snapshot.GeneratedAt"
                                         Mode="_mode" />
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="@FallbackCardClass" Outlined="true" Elevation="0" data-testid="dashboard-active-sessions-fallback">
                        <p class="section-kicker">Active Sessions</p>
                        <h2 class="section-title section-title--card">Panel failed</h2>
                        <p class="section-copy">
                            Active session details are temporarily unavailable.
                        </p>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>

            <ErrorBoundary>
                <ChildContent>
                    <RetryQueuePanel Entries="_snapshot.RetryQueue" GeneratedAt="_snapshot.GeneratedAt" />
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="@FallbackCardClass" Outlined="true" Elevation="0" data-testid="dashboard-retry-queue-fallback">
                        <p class="section-kicker">Retry Queue</p>
                        <h2 class="section-title section-title--card">Panel failed</h2>
                        <p class="section-copy">
                            Retry details are temporarily unavailable.
                        </p>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>

            <ErrorBoundary>
                <ChildContent>
                    <BlockedSessionsPanel Entries="@(_snapshot.BlockedSessions ?? [])"
                                          Mode="_mode" />
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="@FallbackCardClass" Outlined="true" Elevation="0" data-testid="dashboard-blocked-sessions-fallback">
                        <p class="section-kicker">Needs Attention</p>
                        <h2 class="section-title section-title--card">Panel failed</h2>
                        <p class="section-copy">
                            Blocked session details are temporarily unavailable.
                        </p>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>

            <ErrorBoundary>
                <ChildContent>
                    <RecentAttemptsPanel Attempts="_snapshot.RecentAttempts" />
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="@FallbackCardClass" Outlined="true" Elevation="0" data-testid="dashboard-recent-attempts-fallback">
                        <p class="section-kicker">Recent Attempts</p>
                        <h2 class="section-title section-title--card">Panel failed</h2>
                        <p class="section-copy">
                            Recent attempt details are temporarily unavailable.
                        </p>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>
        </section>
    }
</main>

@code {
    private const string SkeletonCardClass = "page-card page-card--tight";
    private const string FallbackCardClass = "page-card page-card--tight";

    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellationTokenSource;
    private Task? _refreshLoopTask;
    private DashboardSnapshot? _snapshot;
    private DashboardPageMode _mode = new(DashboardDataMode.Live);
    private bool _isLoading = true;
    private string? _refreshErrorMessage;

    [Parameter]
    public string? RequestedMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _mode = DashboardPageDataService.ResolveMode(RequestedMode);
        await LoadSnapshotAsync();

        _refreshCancellationTokenSource = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _refreshLoopTask = RunRefreshLoopAsync(_refreshCancellationTokenSource.Token);
    }

    protected override async Task OnParametersSetAsync()
    {
        var resolvedMode = DashboardPageDataService.ResolveMode(RequestedMode);
        if (resolvedMode == _mode)
        {
            return;
        }

        _mode = resolvedMode;
        await LoadSnapshotAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCancellationTokenSource is not null)
        {
            await _refreshCancellationTokenSource.CancelAsync();
            _refreshCancellationTokenSource.Dispose();
            _refreshCancellationTokenSource = null;
        }

        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (_refreshLoopTask is not null)
        {
            try
            {
                await _refreshLoopTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await LoadSnapshotAsync(cancellationToken);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    throw;
                }
                catch (Exception exception)
                {
                    _refreshErrorMessage = exception.Message;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadSnapshotAsync(CancellationToken cancellationToken = default)
    {
        _snapshot = await DashboardPageDataService.GetDashboardSnapshotAsync(_mode, cancellationToken);
        _refreshErrorMessage = null;
        _isLoading = false;
    }
}
