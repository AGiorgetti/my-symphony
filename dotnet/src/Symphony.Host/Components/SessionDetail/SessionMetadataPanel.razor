@using Symphony.Domain.Sessions
@using Symphony.Host.Dashboard

<div data-testid="session-detail-metadata">
    <MudPaper Class="@MetadataCardClass" Outlined="true" Elevation="0">
        <details class="session-metadata-panel__details" data-testid="session-detail-metadata-details">
            <summary class="session-metadata-panel__summary" data-testid="session-detail-metadata-summary">
                <div class="session-metadata-panel__heading">
                    <p class="section-kicker">Details</p>
                    <h2 class="session-metadata-panel__title">Session metadata</h2>
                </div>

                <div class="session-metadata-strip">
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-input-tokens">
                        <span class="session-metadata-chip__label">Rep In</span>
                        <span class="session-metadata-chip__value">@FormatLong(GetReportedInputTokens())</span>
                    </div>
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-cached-input-strip-tokens">
                        <span class="session-metadata-chip__label">Cached</span>
                        <span class="session-metadata-chip__value">@FormatLong(GetReportedCachedInputTokens())</span>
                    </div>
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-output-tokens">
                        <span class="session-metadata-chip__label">Rep Out</span>
                        <span class="session-metadata-chip__value">@FormatLong(GetReportedOutputTokens())</span>
                    </div>
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-reasoning-strip-tokens">
                        <span class="session-metadata-chip__label">Reason</span>
                        <span class="session-metadata-chip__value">@FormatLong(GetReportedReasoningTokens())</span>
                    </div>
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-total-tokens">
                        <span class="session-metadata-chip__label">Rep Total</span>
                        <span class="session-metadata-chip__value">@FormatLong(GetReportedTotalTokens())</span>
                    </div>
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-turn-count">
                        <span class="session-metadata-chip__label">Turns</span>
                        <span class="session-metadata-chip__value">@FormatInt(Metadata.TurnCount)</span>
                    </div>
                    <div class="session-metadata-chip" data-testid="session-detail-metadata-attempt">
                        <span class="session-metadata-chip__label">Attempt</span>
                        <span class="session-metadata-chip__value">@SessionDetailDisplay.GetAttemptLabel(Metadata.Attempt, Metadata.IsAttemptKnown)</span>
                    </div>
                </div>
            </summary>

            <div class="session-metadata-panel__body">
                @if (!string.IsNullOrWhiteSpace(Metadata.AvailabilityMessage))
                {
                    <div class="detail-note">
                        @Metadata.AvailabilityMessage
                    </div>
                }

                <div class="detail-metrics-grid detail-metrics-grid--metadata">
                    <div class="detail-metric-card" data-testid="session-detail-metadata-session-id">
                        <p class="detail-metric-label">Session ID</p>
                        <p class="detail-metric-value detail-metric-value--break">@FormatText(Metadata.SessionId)</p>
                    </div>
                    <div class="detail-metric-card" data-testid="session-detail-metadata-orchestrator-session-id">
                        <p class="detail-metric-label">Orchestrator Session ID</p>
                        <p class="detail-metric-value detail-metric-value--break">@FormatText(Metadata.OrchestratorSessionId)</p>
                    </div>

                    @if (Metadata.TokenUsage is not null)
                    {
                        <div class="detail-metric-card" data-testid="session-detail-metadata-reported-input-tokens">
                            <p class="detail-metric-label">Reported Input Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.ReportedInputTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-reported-output-tokens">
                            <p class="detail-metric-label">Reported Output Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.ReportedOutputTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-cached-input-tokens">
                            <p class="detail-metric-label">Cached Input Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.ReportedCachedInputTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-reasoning-tokens">
                            <p class="detail-metric-label">Reasoning Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.ReportedReasoningTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-reported-total-tokens">
                            <p class="detail-metric-label">Reported Total Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.ReportedTotalTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-estimated-input-tokens">
                            <p class="detail-metric-label">Estimated Input Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.EstimatedInputTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-estimated-output-tokens">
                            <p class="detail-metric-label">Estimated Output Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.EstimatedOutputTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-estimated-total-tokens">
                            <p class="detail-metric-label">Estimated Total Tokens</p>
                            <p class="detail-metric-value">@FormatLong(Metadata.TokenUsage.EstimatedTotalTokens)</p>
                        </div>
                        <div class="detail-metric-card" data-testid="session-detail-metadata-comparison-status">
                            <p class="detail-metric-label">Token Comparison</p>
                            <p class="detail-metric-value">@FormatComparisonStatus(Metadata.TokenUsage)</p>
                        </div>
                    }
                </div>
            </div>
        </details>
    </MudPaper>
</div>

@code {
    private const string MetadataCardClass = "page-card page-card--tight session-metadata-panel";

    [Parameter]
    [EditorRequired]
    public required SessionMetadataPanelModel Metadata { get; set; }

    private static string FormatLong(long? value)
    {
        return value?.ToString("N0") ?? "Unavailable";
    }

    private static string FormatInt(int? value)
    {
        return value?.ToString() ?? "Unavailable";
    }

    private static string FormatText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Unavailable" : value;
    }

    private static string FormatComparisonStatus(DashboardSessionTokenUsageSnapshot tokenUsage)
    {
        return tokenUsage.ComparisonStatus switch
        {
            SessionTokenComparisonStatus.None => "Unavailable",
            SessionTokenComparisonStatus.EstimatedOnly => "Estimated only",
            SessionTokenComparisonStatus.ReportedOnly => "Reported only",
            SessionTokenComparisonStatus.Match => "Match",
            SessionTokenComparisonStatus.Mismatch => $"Mismatch ({tokenUsage.TotalDelta:+#;-#;0})",
            _ => tokenUsage.ComparisonStatus.ToString()
        };
    }

    private long? GetReportedInputTokens() => Metadata.TokenUsage?.ReportedInputTokens ?? Metadata.InputTokens;

    private long? GetReportedCachedInputTokens() => Metadata.TokenUsage?.ReportedCachedInputTokens;

    private long? GetReportedOutputTokens() => Metadata.TokenUsage?.ReportedOutputTokens ?? Metadata.OutputTokens;

    private long? GetReportedReasoningTokens() => Metadata.TokenUsage?.ReportedReasoningTokens;

    private long? GetReportedTotalTokens() => Metadata.TokenUsage?.ReportedTotalTokens ?? Metadata.TotalTokens;
}
