<div data-testid="session-detail-timeline">
<Card Slots="@TimelineCardSlots">
    <div class="space-y-2">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-[color:var(--color-primary-DEFAULT)]">Timeline</p>
        <h2 class="text-2xl font-semibold text-[color:var(--color-on-surface-primary)]">Session activity</h2>
        <p class="text-sm leading-6 text-[color:var(--color-on-surface-secondary)]">
            Lifecycle milestones, agent messages, warnings, and outcomes in chronological order.
        </p>
    </div>

    @if (Timeline.LatestAttentionAlert is not null)
    {
        <div data-testid="session-detail-latest-attention-alert">
            <Alert Color="@Timeline.LatestAttentionAlert.Color"
                   Rounded="true"
                   WithBorderAccent="true"
                   TextEmphasis="@Timeline.LatestAttentionAlert.Emphasis"
                   Text="@Timeline.LatestAttentionAlert.Message" />
        </div>
    }

    @if (Timeline.FailureAlert is not null)
    {
        <div data-testid="session-detail-failure-alert">
            <Alert Color="@Timeline.FailureAlert.Color"
                   Rounded="true"
                   WithBorderAccent="true"
                   TextEmphasis="@Timeline.FailureAlert.Emphasis"
                   Text="@Timeline.FailureAlert.Message" />
        </div>
    }

    @if (Timeline.Entries.Count == 0)
    {
        <EmptyState Title="No session activity recorded"
                    Description="The session exists, but no timeline entries are available yet." />
    }
    else
    {
        <Timeline Order="TimelineOrder.Vertical">
            @for (var index = 0; index < Timeline.Entries.Count; index++)
            {
                var entry = Timeline.Entries[index];
                <TimelineItem Title="@entry.Title"
                              Date="@entry.TimestampLabel"
                              Color="@entry.Color"
                              IsLast="@(index == Timeline.Entries.Count - 1)"
                              DatePrefix="Logged at">
                    <ChildContent>
                        <div class="@GetEntryContainerClasses(entry)" data-testid="session-detail-timeline-entry">
                            <div class="flex flex-wrap items-center gap-2">
                                <div class="inline-flex shrink-0">
                                    <Badge Color="@entry.KindBadgeColor">
                                        @entry.KindLabel
                                    </Badge>
                                </div>

                                @if (entry.Facts.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var fact in entry.Facts)
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full border border-[var(--shell-border)]/80 bg-[color:var(--color-surface-base)]/65 px-2.5 py-1 text-xs text-[color:var(--color-on-surface-secondary)]">
                                                <span class="font-semibold text-[color:var(--color-on-surface-primary)]">@fact.Label:</span>
                                                <span>@fact.Value</span>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(entry.Summary))
                            {
                                <p class="text-sm leading-6 text-[color:var(--color-on-surface-secondary)]">
                                    @entry.Summary
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(entry.Detail))
                            {
                                @if (entry.HasExpandableDetail)
                                {
                                    <details class="rounded-xl border border-[var(--shell-border)]/80 bg-[color:var(--color-surface-base)]/70 p-3"
                                             data-testid="session-detail-timeline-detail">
                                        <summary class="cursor-pointer list-none text-sm font-semibold text-[color:var(--color-on-surface-primary)]">
                                            @entry.DetailToggleLabel
                                        </summary>

                                        @if (entry.IsStructuredDetail)
                                        {
                                            <pre class="mt-3 overflow-x-auto whitespace-pre-wrap break-all rounded-lg bg-[color:var(--color-surface-raised)] p-3 text-xs leading-6 text-[color:var(--color-on-surface-secondary)]">@entry.Detail</pre>
                                        }
                                        else
                                        {
                                            <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-[color:var(--color-on-surface-secondary)]">@entry.Detail</p>
                                        }
                                    </details>
                                }
                                else
                                {
                                    <p class="text-sm leading-6 text-[color:var(--color-on-surface-secondary)]">@entry.Detail</p>
                                }
                            }
                        </div>
                    </ChildContent>
                </TimelineItem>
            }
        </Timeline>
    }
</Card>
</div>

@code {
    private static readonly CardSlots TimelineCardSlots = new()
    {
        Base = "rounded-[var(--shell-radius-xl)] border border-[var(--shell-border)] bg-[color:var(--color-surface-raised)] shadow-[var(--shell-shadow)]",
        Body = "flex flex-col gap-4 p-5"
    };

    [Parameter]
    [EditorRequired]
    public required SessionActivityTimelineModel Timeline { get; set; }

    private static string GetEntryContainerClasses(SessionActivityTimelineEntryModel entry)
    {
        var baseClasses = "space-y-3 rounded-[var(--shell-radius-lg)] border p-4";

        return entry.Kind switch
        {
            SessionActivityKind.Warning => $"{baseClasses} border-amber-400/30 bg-amber-400/7",
            SessionActivityKind.Error => $"{baseClasses} border-rose-400/35 bg-rose-400/8",
            SessionActivityKind.Outcome when entry.Color == TimelineColor.Red => $"{baseClasses} border-rose-400/30 bg-rose-400/7",
            SessionActivityKind.Outcome when entry.Color == TimelineColor.Green => $"{baseClasses} border-emerald-400/25 bg-emerald-400/6",
            _ => $"{baseClasses} border-[var(--shell-border)]/80 bg-[color:var(--color-surface-base)]/38"
        };
    }
}
