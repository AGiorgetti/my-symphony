<div data-testid="session-detail-timeline">
    <MudPaper Class="@TimelineCardClass" Outlined="true" Elevation="0">
        <div class="panel-header__content">
            <p class="section-kicker">Timeline</p>
            <h2 class="section-title section-title--panel">Session activity</h2>
            <p class="section-copy">
                Lifecycle milestones, agent messages, warnings, and outcomes in chronological order.
            </p>
        </div>

        @if (DebugModeEnabled)
        {
            <div data-testid="session-detail-debug-banner">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    <strong>Debug mode enabled:</strong> Raw agent payloads and diagnostic metadata are visible on this page only while host debug mode is on.
                </MudAlert>
            </div>
        }

        @if (Timeline.LatestAttentionAlert is not null)
        {
            <div data-testid="session-detail-latest-attention-alert">
                <MudAlert Severity="@Timeline.LatestAttentionAlert.Color" Variant="Variant.Outlined" Dense="true">
                    <strong>@Timeline.LatestAttentionAlert.Emphasis</strong> @Timeline.LatestAttentionAlert.Message
                </MudAlert>
            </div>
        }

        @if (Timeline.FailureAlert is not null)
        {
            <div data-testid="session-detail-failure-alert">
                <MudAlert Severity="@Timeline.FailureAlert.Color" Variant="Variant.Outlined" Dense="true">
                    <strong>@Timeline.FailureAlert.Emphasis</strong> @Timeline.FailureAlert.Message
                </MudAlert>
            </div>
        }

        @if (Timeline.Entries.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-state__title">No session activity recorded</p>
                <p class="empty-state__copy">
                    The session exists, but no timeline entries are available yet.
                </p>
            </div>
        }
        else
        {
            <ol class="timeline-list">
                @foreach (var entry in Timeline.Entries)
                {
                    <li class="timeline-item">
                        <span class="@GetTimelineDotClasses(entry)"></span>
                        <div class="@GetEntryContainerClasses(entry)" data-testid="session-detail-timeline-entry">
                            <div class="timeline-entry__head">
                                <div class="timeline-entry__meta">
                                    <StatusPill Text="@entry.KindLabel" Color="@entry.KindBadgeColor" />
                                    @if (entry.Facts.Count > 0)
                                    {
                                        <div class="fact-list">
                                            @foreach (var fact in entry.Facts)
                                            {
                                                <span class="fact-pill">
                                                    <span class="fact-pill__label">@fact.Label:</span>
                                                    <span>@fact.Value</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="timeline-entry__time">
                                    @entry.TimestampLabel
                                </div>
                            </div>

                            <div class="timeline-entry__body">
                                <h3 class="timeline-entry__title">@entry.Title</h3>

                                @if (!string.IsNullOrWhiteSpace(entry.Summary))
                                {
                                    <p class="timeline-entry__summary">
                                        @entry.Summary
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                {
                                    @if (ShouldRenderExpandableDetail(entry))
                                    {
                                        <details class="@GetDetailClasses(entry)"
                                                 data-testid="session-detail-timeline-detail">
                                            <summary class="timeline-entry__toggle">
                                                @GetDetailToggleLabel(entry)
                                            </summary>

                                            @if (ShouldRenderDebugMetadata(entry))
                                            {
                                                <div class="timeline-entry__detail-body">
                                                    <p class="detail-metric-label">Debug metadata</p>
                                                    <div class="fact-list">
                                                        <span class="fact-pill">
                                                            <span class="fact-pill__label">Source:</span>
                                                            <span>@entry.KindLabel</span>
                                                        </span>
                                                        <span class="fact-pill">
                                                            <span class="fact-pill__label">Timestamp:</span>
                                                            <span>@entry.TimestampLabel</span>
                                                        </span>
                                                        <span class="fact-pill">
                                                            <span class="fact-pill__label">Event:</span>
                                                            <span>@entry.Title</span>
                                                        </span>
                                                    </div>
                                                </div>
                                            }

                                            @if (entry.IsStructuredDetail)
                                            {
                                                @if (entry.Facts.Count > 0)
                                                {
                                                    <div class="timeline-entry__detail-body">
                                                        <p class="detail-metric-label">Highlights</p>
                                                        <div class="fact-list">
                                                            @foreach (var fact in entry.Facts)
                                                            {
                                                                <span class="fact-pill">
                                                                    <span class="fact-pill__label">@fact.Label:</span>
                                                                    <span>@fact.Value</span>
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <p class="detail-metric-label">@(ShouldRenderDebugMetadata(entry) ? "Raw payload" : "Detail")</p>
                                                <pre class="timeline-pre">@entry.Detail</pre>
                                            }
                                            else
                                            {
                                                <p class="detail-metric-label">@(ShouldRenderDebugMetadata(entry) ? "Debug detail" : "Detail")</p>
                                                <p class="timeline-text">@entry.Detail</p>
                                            }
                                        </details>
                                    }
                                    else if (ShouldRenderInlineDetail(entry))
                                    {
                                        <p class="timeline-text">@entry.Detail</p>
                                    }
                                    else
                                    {
                                        <p class="timeline-entry__summary timeline-entry__summary--muted">
                                            Enable dashboard debug mode to inspect the raw agent payload for this event.
                                        </p>
                                    }
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>
        }
    </MudPaper>
</div>

@code {
    private const string TimelineCardClass = "page-card page-card--tight";

    [Parameter]
    [EditorRequired]
    public required SessionActivityTimelineModel Timeline { get; set; }

    [Parameter]
    public bool DebugModeEnabled { get; set; }

    private static string GetEntryContainerClasses(SessionActivityTimelineEntryModel entry)
    {
        var baseClasses = "timeline-entry";

        return entry.Kind switch
        {
            SessionActivityKind.Warning => $"{baseClasses} timeline-entry--warning",
            SessionActivityKind.Error => $"{baseClasses} timeline-entry--error",
            SessionActivityKind.Outcome when entry.Color == Color.Error => $"{baseClasses} timeline-entry--error",
            SessionActivityKind.Outcome when entry.Color == Color.Success => $"{baseClasses} timeline-entry--success",
            _ => $"{baseClasses} timeline-entry--default"
        };
    }

    private static string GetTimelineDotClasses(SessionActivityTimelineEntryModel entry)
    {
        return entry.Color switch
        {
            Color.Info => "timeline-dot timeline-dot--info",
            Color.Warning => "timeline-dot timeline-dot--warning",
            Color.Error => "timeline-dot timeline-dot--error",
            Color.Success => "timeline-dot timeline-dot--success",
            _ => "timeline-dot timeline-dot--default"
        };
    }

    private bool ShouldRenderExpandableDetail(SessionActivityTimelineEntryModel entry)
    {
        if (!entry.HasExpandableDetail)
        {
            return false;
        }

        return DebugModeEnabled || entry.Kind != SessionActivityKind.AgentMessage || !entry.IsStructuredDetail;
    }

    private bool ShouldRenderInlineDetail(SessionActivityTimelineEntryModel entry)
    {
        if (entry.HasExpandableDetail)
        {
            return false;
        }

        return !entry.IsStructuredDetail || DebugModeEnabled || entry.Kind != SessionActivityKind.AgentMessage;
    }

    private bool ShouldRenderDebugMetadata(SessionActivityTimelineEntryModel entry)
    {
        return DebugModeEnabled && entry.Kind == SessionActivityKind.AgentMessage;
    }

    private string GetDetailClasses(SessionActivityTimelineEntryModel entry)
    {
        return ShouldRenderDebugMetadata(entry)
            ? "timeline-entry__detail timeline-entry__detail--debug"
            : "timeline-entry__detail";
    }

    private string? GetDetailToggleLabel(SessionActivityTimelineEntryModel entry)
    {
        if (!ShouldRenderDebugMetadata(entry))
        {
            return entry.DetailToggleLabel;
        }

        return entry.IsStructuredDetail
            ? "View raw payload and debug metadata"
            : "View debug detail";
    }
}