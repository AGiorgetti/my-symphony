@using Symphony.Host.Components.Sessions

<div data-testid="session-detail-header">
    <MudPaper Class="@HeaderClass" Outlined="true" Elevation="0">
        <div class="detail-header">
            <div class="detail-header__content">
                <div>
                    <p class="section-kicker">Session</p>
                    <h1 class="page-title page-title--secondary">@Session.Identifier</h1>
                </div>
                <div class="detail-status-row">
                    <SessionStatusBadge Status="@Session.Status"
                                       Text="@Session.StatusText"
                                       ColorOverride="@(Session.Status is null ? Session.StatusColor : null)" />
                    @if (Session.IsActive)
                    {
                        <div class="detail-active-indicator"
                             data-testid="session-header-active-indicator">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                            <span>Session is active</span>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Session.IssueUrl))
            {
                <MudButton Variant="Variant.Outlined"
                           Href="@Session.IssueUrl"
                           Class="detail-header__link"
                           data-testid="session-header-tracker-link">
                    Open tracker issue
                </MudButton>
            }
        </div>

        <div class="detail-metrics-grid">
            <div class="detail-metric-card">
                <p class="detail-metric-label">Started</p>
                <p class="detail-metric-value">@SessionDetailDisplay.FormatTimestamp(Session.StartedAt)</p>
            </div>
            <div class="detail-metric-card">
                <p class="detail-metric-label">Ended</p>
                <p class="detail-metric-value">
                    @(Session.EndedAt is null ? "Still running" : SessionDetailDisplay.FormatTimestamp(Session.EndedAt.Value))
                </p>
            </div>
        </div>
    </MudPaper>
</div>

@code {
    private const string HeaderClass = "page-card";

    [Parameter]
    [EditorRequired]
    public required SessionHeaderDisplayModel Session { get; set; }
}
